# Backend
NODE_ENV=development
PORT=3000

# PostgreSQL
# No Docker, use o nome do servico do banco no Compose como host.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=greener
POSTGRES_USER=greener
# Senha apenas no .env local.
POSTGRES_PASSWORD=

# APIs auxiliares
METRICS_API_URL=https://metrics.unilaunch.org
CARBON_API_URL=https://carbon.unilaunch.org

# Autenticacao
# Defina um segredo aleatorio no .env local.
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Monitoramento (em milissegundos)
COLLECTION_INTERVAL_MS=60000
EXTERNAL_API_TIMEOUT_MS=10000

# Origem do frontend permitida pelo backend; ajuste conforme a porta utilizada.
CORS_ORIGIN=http://localhost:5173
